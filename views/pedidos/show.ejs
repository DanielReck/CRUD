<h1>Pedido #<%= pedido.id %></h1>
<p>Cliente: <%= pedido.cliente_nome %></p>
<p>Valor total: <%= pedido.valor_total %></p>
<p>Tipo entrega: <%= pedido.tipo_entrega %></p>
<p>Status: <%= pedido.status %></p>
<p>Observação: <%= pedido.observacao %></p>

<h3>Itens</h3>
<table class="table">
  <thead><tr><th>ID</th><th>Produto</th><th>Quantidade</th><th>Preço Unit.</th></tr></thead>
  <tbody>
    <% (items||[]).forEach(function(it){ %>
      <tr>
        <td><%= it.id %></td>
        <td><%= it.produto_nome %></td>
        <td><%= it.quantidade %></td>
        <td><%= it.preco_unitario %></td>
      </tr>
    <% }) %>
  </tbody>
</table>

<a class="btn btn-secondary" href="/pedidos">Voltar</a>
