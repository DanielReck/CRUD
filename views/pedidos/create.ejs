<h1>Criar Pedido</h1>
<form action="/pedidos" method="POST">
  <div class="form-group">
    <label for="id_cliente">ID Cliente</label>
    <input id="id_cliente" name="id_cliente" class="form-control" required>
  </div>
  <div class="form-group">
    <label for="id_forma_pagamento">Forma de Pagamento</label>
    <select id="id_forma_pagamento" name="id_forma_pagamento" class="form-control">
      <option value="">-- selecione --</option>
      <% (formas||[]).forEach(function(f){ %>
        <option value="<%= f.id %>"><%= f.descricao %></option>
      <% }) %>
    </select>
  </div>
  <div class="form-group">
    <label for="tipo_entrega">Tipo Entrega</label>
    <select id="tipo_entrega" name="tipo_entrega" class="form-control">
      <option value="RETIRADA">Retirada</option>
      <option value="ENTREGA">Entrega</option>
    </select>
  </div>
  <div class="form-group">
    <label for="observacao">Observação</label>
    <input id="observacao" name="observacao" class="form-control">
  </div>
  <div class="form-group">
    <label for="valor_total">Valor total (opcional)</label>
    <input id="valor_total" name="valor_total" class="form-control" type="number" step="0.01">
  </div>

  <h4>Itens (opcional via formulário simples)</h4>
  <div id="items">
    <div class="item form-row">
      <div class="col"><input name="items[0][id_produto]" placeholder="produto id" class="form-control"></div>
      <div class="col"><input name="items[0][quantidade]" placeholder="quantidade" class="form-control" value="1"></div>
      <div class="col"><input name="items[0][preco_unitario]" placeholder="preco" class="form-control"></div>
    </div>
  </div>

  <button class="btn btn-primary mt-2" type="submit">Criar Pedido</button>
</form>

