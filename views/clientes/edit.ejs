<h1>Editar cliente</h1>

<form
    action="/clientes/<%= cliente.id %>?_method=PUT"
    method="POST"
>
    <div>
        <label for="nome">Nome</label>
        <input
            id="nome"
            name="nome"
            value="<%= cliente.nome %>"
            required
        >
    </div>

    <div>
        <label for="email">E-mail</label>
        <input
            id="email"
            name="email"
            type="email"
            value="<%= cliente.email || '' %>"
        >
    </div>

    <div>
        <label for="telefone">Telefone</label>
        <input
            id="telefone"
            name="telefone"
            value="<%= cliente.telefone || '' %>"
        >
    </div>

    <div>
        <label for="cpf">CPF</label>
        <input
            id="cpf"
            name="cpf"
            value="<%= cliente.cpf || '' %>"
        >
    </div>

    <div>
        <label for="instituicao">Instituição</label>
        <input
            id="instituicao"
            name="instituicao"
            value="<%= cliente.instituicao || '' %>"
        >
    </div>

    <button type="submit">Salvar</button>
    <a href="/clientes">Cancelar</a>
</form>