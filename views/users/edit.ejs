<h1>Editar Cliente</h1>

<form action="/users/<%= user.id %>?_method=PUT" method="POST">
  <div>
    <label for="nome">Nome</label>
    <input id="nome" name="nome" value="<%= user.nome %>" required>
  </div>
  <div>
    <label for="email">Email</label>
    <input id="email" name="email" type="email" value="<%= user.email %>">
  </div>
  <div>
    <label for="telefone">Telefone</label>
    <input id="telefone" name="telefone" value="<%= user.telefone %>">
  </div>
  <div>
    <label for="cpf">CPF</label>
    <input id="cpf" name="cpf" value="<%= user.cpf %>">
  </div>
  <div>
    <label for="instituicao">Instituição</label>
    <input id="instituicao" name="instituicao" value="<%= user.instituicao %>">
  </div>
  <button type="submit">Salvar</button>
</form>
 
