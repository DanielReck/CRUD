<h1>Editar Produto</h1>

<form action="/produtos/<%= produto.id %>?_method=PUT" method="POST">
  <div>
    <label for="nome">Nome</label>
    <input id="nome" name="nome" value="<%= produto.nome %>" required>
  </div>
  <div>
    <label for="descricao">Descrição</label>
    <textarea id="descricao" name="descricao"><%= produto.descricao %></textarea>
  </div>
  <div>
    <label for="preco">Preço</label>
    <input id="preco" name="preco" type="number" step="0.01" value="<%= produto.preco %>">
  </div>
  <div>
    <label for="tamanho">Tamanho</label>
    <input id="tamanho" name="tamanho" value="<%= produto.tamanho %>">
  </div>
  <div>
    <label for="imagem_url">Imagem URL</label>
    <input id="imagem_url" name="imagem_url" value="<%= produto.imagem_url %>">
  </div>
  <div>
    <label for="obs">Observação</label>
    <input id="obs" name="obs" value="<%= produto.obs %>">
  </div>
  <div>
    <label for="disponivel">Disponível</label>
    <input id="disponivel" name="disponivel" type="checkbox" value="1" <%= produto.disponivel ? 'checked' : '' %> >
  </div>
  <button type="submit">Salvar</button>
</form>
